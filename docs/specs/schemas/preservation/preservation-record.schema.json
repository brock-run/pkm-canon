          "loss_prevention",
          "future_replay",
          "source_audit",
          "unsupported_feature",
          "adapter_roundtrip",
          "binary_attachment",
          "legal_archive",
          "debugging"
        ],
        "type": "string"
      },
      "title": "Preservation Reason",
      "type": "array"
    },
    "record_type": {
      "const": "preservation_record",
