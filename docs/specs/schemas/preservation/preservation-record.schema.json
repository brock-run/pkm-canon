{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/preservation/preservation-record",
  "title": "preservation-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_type": {
      "const": "preservation_record"
    },
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "source_object_type": {
      "type": "string"
    },
    "capture_type": {
      "enum": [
        "raw_json",
        "raw_html",
        "raw_markdown",
        "raw_xml",
        "plain_text",
        "rich_text_fragment",
        "binary_blob",
        "rendered_preview",
        "unsupported_object",
        "adapter_sidecar"
      ]
    },
    "storage": {
      "$ref": "https://example.org/schemas/common/source-native-reference"
    },
    "normalization_status": {
      "enum": [
        "unprocessed",
        "partial",
        "normalized",
        "deferred",
        "unsupported"
      ]
    },
    "preservation_reason": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "facets": {
      "type": "object"
    }
  },
  "required": [
    "record_type",
    "schema_version",
    "id",
    "subject_id",
    "source_system",
    "source_object_type",
    "capture_type",
    "storage",
    "normalization_status"
  ]
}