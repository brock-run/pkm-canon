{
  "$id": "urn:pkm-canon:schema:v1:evaluation:evaluation-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "none"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "coverage_matched": {
      "title": "Coverage Matched",
      "type": "boolean"
    },
    "expected_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Expected Node Ids",
      "type": "array"
    },
    "index_id": {
      "title": "Index Id",
      "type": "string"
    },
    "missing_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Missing Node Ids",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "recall": {
      "maximum": 1,
      "minimum": 0,
      "title": "Recall",
      "type": "number"
    },
    "retrieved_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Retrieved Node Ids",
      "type": "array"
    },
    "source_package_id": {
      "title": "Source Package Id",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "source_package_id",
    "index_id",
    "retrieved_node_ids",
    "expected_node_ids",
    "missing_node_ids",
    "coverage",
    "coverage_matched",
    "recall",
    "passed"
  ],
  "title": "evaluation-result",
  "type": "object"
}
