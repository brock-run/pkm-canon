{
  "$id": "urn:pkm-canon:schema:v1:evaluation:evaluation-case",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "expected_coverage": {
      "enum": [
        "complete",
        "partial",
        "none"
      ],
      "title": "Expected Coverage",
      "type": "string"
    },
    "expected_node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Expected Node Ids",
      "type": "array"
    },
    "principal_id": {
      "title": "Principal Id",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "source_package_id": {
      "title": "Source Package Id",
      "type": "string"
    },
    "task_type": {
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "source_package_id",
    "query",
    "task_type",
    "principal_id",
    "expected_node_ids",
    "expected_coverage"
