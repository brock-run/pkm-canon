{
  "$id": "urn:pkm-rosetta:schema:v1:knowledge:review-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "reviewer_id": {
      "title": "Reviewer Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "proposal_id",
    "reviewer_id",
    "run_id",
    "decision",
    "decided_at",
    "policy_version"
  ],
  "title": "review-event",
  "type": "object"
}
