{
  "$id": "urn:pkm-canon:schema:v1:knowledge:domain-claim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "object": {
      "title": "Object",
      "type": "string"
    },
    "predicate": {
      "enum": [
        "owned_by",
        "described_as"
      ],
      "title": "Predicate",
      "type": "string"
    },
    "source_trace_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Trace Ids",
      "type": "array"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "approved",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    }
  },
  "required": [
    "claim_id",
    "subject",
    "predicate",
    "object",
    "source_trace_ids"
  ],
  "title": "domain-claim",
  "type": "object"
}
