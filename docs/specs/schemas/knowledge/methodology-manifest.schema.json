{
  "$defs": {
    "MethodologyRule": {
      "additionalProperties": false,
      "properties": {
        "blank_value_count": {
          "default": 0,
          "minimum": 0,
          "title": "Blank Value Count",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "cooccurring_keys": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Cooccurring Keys",
          "type": "object"
        },
        "distinct_document_count": {
          "default": 0,
          "minimum": 0,
          "title": "Distinct Document Count",
          "type": "integer"
        },
        "key_variants": {
          "items": {
            "type": "string"
          },
          "title": "Key Variants",
          "type": "array"
        },
        "observation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "placeholder_value_count": {
          "default": 0,
          "minimum": 0,
          "title": "Placeholder Value Count",
          "type": "integer"
        },
        "review_priority": {
          "default": "review",
          "enum": [
            "review",
            "defer"
          ],
          "title": "Review Priority",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_type": {
          "enum": [
            "attribute_convention",
            "tag_convention",
            "link_convention"
          ],
          "title": "Rule Type",
          "type": "string"
        },
        "source_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Scope"
        },
        "source_trace_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Trace Ids",
          "type": "array"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "approved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "substantive_value_count": {
          "default": 0,
          "minimum": 0,
          "title": "Substantive Value Count",
          "type": "integer"
        }
      },
      "required": [
        "rule_id",
        "rule_type",
        "statement",
        "confidence",
        "source_trace_ids"
      ],
      "title": "MethodologyRule",
      "type": "object"
    }
  },
  "$id": "urn:pkm-canon:schema:v1:knowledge:methodology-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "manifest_id": {
      "title": "Manifest Id",
      "type": "string"
    },
    "review_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Review Event Ids",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/MethodologyRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "source_package_id": {
      "title": "Source Package Id",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "source_package_id",
    "rules",
    "review_event_ids",
    "generated_at"
  ],
  "title": "methodology-manifest",
  "type": "object"
}
