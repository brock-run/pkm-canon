{
  "$id": "urn:pkm-rosetta:schema:v1:shared:native-link",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "link_id": {
      "title": "Link Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_representation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Representation"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "target_kind": {
      "enum": [
        "canonical",
        "tag",
        "external"
      ],
      "title": "Target Kind",
      "type": "string"
    }
  },
  "required": [
    "link_id",
    "source_id",
    "target_id",
    "kind",
    "target_kind"
  ],
  "title": "native-link",
  "type": "object"
}
