    "facets": {
      "additionalProperties": {
        "$ref": "#/$defs/FacetEnvelope"
      },
      "title": "Facets",
      "type": "object"
    }
  },
  "required": [
    "span_id",
    "node_id",
    "kind",
    "text"
  ],
  "title": "spans",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/core/spans"
